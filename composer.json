{
    "name": "netopia/payment2",
    "description": "NETOPIA Payments SDK — PHP library for integrating NETOPIA online card payments with 3D Secure and installments support.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "NETOPIA Payments",
            "email": "implementare@netopia-system.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Netopia\\Payment2\\": "src/",
            "Netopia\\CsCart\\": "app/addons/netopia_payments/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netopia\\Payment2\\Tests\\": "tests/",
            "Netopia\\Payment2\\Tests\\CsCart\\": "tests/CsCart/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    }
}
